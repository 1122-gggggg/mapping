    "cross_grid": 10,
    "roma_cert_thresh": 0.35,
    "mvroma_sample_mode": "random",
    "mvroma_sample_grid": "8x12",
    "agg_maxkp": 4000,
    "agg_intra_degree_cap": 0,
    "agg_cross_direction_degree_cap": 8,
    "agg_pair_degree_cap": 18,
    "doppelgangers_checkpoint": "",
    "doppelgangers_threshold": 0.8,
    "doppelgangers_filter_scope": "all",
    "pair_verification": "off",
    "pair_verification_action": "filter",
    "dms_max_matches": 512,
    "repair_dense_h5": false,
    "glomap_skip_bundle_adjustment": false,
    "glomap_skip_retriangulation": true,
    "glomap_optimize_intrinsics": 0,
    "lfoe_mode": "off",
    "glomap_max_num_tracks": 600000,
    "glomap_min_num_view_per_track": 0,
    "glomap_min_triangulation_angle": 0.0,
    "xfeat_topk": 2048,
    "snap_px": 5.0,
    "tri_pair_topk": 20
