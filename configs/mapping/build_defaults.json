{
  "pipeline": "建圖",
  "default_technique": "MegaLoc retrieval + MV-RoMA cross-direction matching + GLOMAP",
  "paths_relative_to": "sfm_system",
  "entrypoint": "建圖/pipeline/build_pipeline.py",
  "core": "建圖/pipeline/build_localizable_map_core.py",
  "python": "/usr/bin/python3.12",
  "python_sfm": "/usr/bin/python3.12",
  "external_tools": {
    "mvroma_root": "建圖/external_tools/MV-RoMa",
    "mvroma_weights": "建圖/external_tools/MV-RoMa/outdoor_final.pth",
    "ufm_root": "建圖/external_tools/UFM"
  },
  "optional_tools_disabled_by_default": {
    "lfoe_global_sfm": "建圖/external_tools/LFOE-GlobalSfM",
    "doppelgangers_plusplus": "建圖/external_tools/doppelgangers-plusplus",
    "dms_pair_verification": false
  },
  "default_stages": "all",
  "major_defaults": {
    "megaloc_num_matched": 20,
    "motion_gate": false,
    "motion_action": "report",
    "motion_min_flow_px": 1.5,
