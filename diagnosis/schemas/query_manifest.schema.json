{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1122-gggggg/diagnosis_map/schemas/query_manifest.schema.json",
  "title": "MapDoctor immutable query manifest",
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries"],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
