{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical localization reference",
  "type": "object",
  "required": [
    "reference_id",
    "image_path",
    "pose",
    "provenance",
    "state",
    "stable_ratio",
    "current_point3d_ids"
  ],
  "properties": {
    "reference_id": {"type": "string"},
    "image_path": {"type": "string"},
    "provenance": {"enum": ["DIRECT", "BRIDGED"]},
    "state": {"type": "string"},
    "stable_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "bridge_depth": {"type": "integer", "minimum": 0},
    "anchor_ids": {"type": "array", "items": {"type": "string"}},
    "bridge_path_count": {"type": "integer", "minimum": 0},
    "current_point3d_ids": {"type": "array", "items": {"type": "integer"}},
    "pose": {
      "type": "object",
      "required": ["R_cw", "t_cw"],
      "properties": {
        "R_cw": {"type": "array"},
        "t_cw": {"type": "array"}
      }
    }
  },
  "additionalProperties": true
}
